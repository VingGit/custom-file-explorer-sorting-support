{
  "name": "@vinggit/custom-file-explorer-sorting-support",
  "version": "0.2.0",
  "description": "Use Obsidian Custom File Explorer Sorting specifications in Quartz navigation.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "VingGit",
  "homepage": "https://github.com/VingGit/custom-file-explorer-sorting-support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VingGit/custom-file-explorer-sorting-support.git"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "obsidian",
    "custom-sort",
    "file-explorer",
    "navigation"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "fixture:generate": "node scripts/generate-integration-vault.mjs",
    "fixture:check": "npm run fixture:generate && git diff --exit-code -- test-vault",
    "test:integration": "npm run build && node scripts/run-quartz-integration.mjs",
    "test:upstream": "node scripts/check-upstream-compatibility.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vfile": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "vfile": {
      "optional": false
    }
  },
  "dependencies": {
    "obsidian-custom-sort": "github:SebastianMC/obsidian-custom-sort#6100b0c664988b08460c0b7312f77d98770fe3fa"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "quartz": {
    "name": "custom-file-explorer-sorting-support",
    "displayName": "Custom File Explorer Sorting Support",
    "description": "Applies Obsidian Custom File Explorer Sorting specifications to Quartz navigation.",
    "author": "VingGit",
    "homepage": "https://github.com/VingGit/custom-file-explorer-sorting-support",
    "keywords": [
      "quartz",
      "obsidian",
      "custom-sort",
      "file-explorer",
      "navigation"
    ],
    "category": "emitter",
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 35,
    "defaultEnabled": false,
    "defaultOptions": {
      "specProperty": "sorting-spec",
      "bookmarksOrderProperty": "bookmarks-order",
      "iconProperty": "icon"
    },
    "configSchema": {
      "specProperty": {
        "type": "string"
      },
      "bookmarksOrderProperty": {
        "type": "string"
      },
      "iconProperty": {
        "type": "string"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
